<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without it iOS never issues an APNs
	     token, so FCM has nothing to deliver to and getToken() returns null
	     (syncDeviceToken just logs and gives up). "development" is right for
	     Xcode/debug installs; an App Store / TestFlight export rewrites it to
	     "production" from the distribution profile. The App ID must also
	     have Push Notifications enabled in the Apple Developer portal. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
