<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.NFC"/>
    <!-- Android 13+ (API 33) requires this as a runtime-requested
         permission before any notification (including FCM-delivered ones)
         can display -- without it, pushes still arrive and update the
         in-app Notification list, but silently, with no system tray
         banner. firebase_messaging's requestPermission() call (wired in
         notification_service.dart) is what actually triggers the runtime
         prompt; this manifest entry just declares the permission exists. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- required="false": MIFARE cards remain a valid check-in path, so an
         HCE-incapable device shouldn't be blocked from installing the app
         entirely, it just won't be able to use the phone-tap flow. -->
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false"/>
    <application
        android:label="suaams"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Custom HCE service (SuaamsHceService.kt): broadcasts the
             beacon token (see api/student.py's mint_checkin_beacon) over
             NFC to the ESP32/PN532 terminal. exported="true" is required
             for HOST_APDU_SERVICE (the system NFC stack, not another app,
             is what binds to it); BIND_NFC_SERVICE restricts binding to
             that system service specifically. -->
        <service
            android:name=".SuaamsHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE"/>
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice"/>
        </service>

        <!-- FCM default notification channel/icon for when a data+notification
             message arrives while the app is backgrounded/terminated -- the
             Android system tray needs SOME channel id to post to before the
             app process is even running to set one up in Dart. Must match
             the channel id created by flutter_local_notifications in
             notification_service.dart (both use 'suaams_notifications'), or
             backgrounded pushes would silently use Android's default
             low-importance channel instead of the one actually configured. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="suaams_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
