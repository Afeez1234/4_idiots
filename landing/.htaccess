# Apache settings for the landing page on WhoGoHost (cPanel).

# Android only offers to install a download served with this type.
AddType application/vnd.android.package-archive .apk

# Header lines need mod_headers; wrapped so a host without it still
# serves the site instead of a 500 error.
<IfModule mod_headers.c>
# Always download APKs rather than showing them as text.
<FilesMatch "\.apk$">
  Header set Content-Disposition attachment
  Header set Cache-Control "no-cache"
</FilesMatch>

# Pages revalidate so edits show up at once; the CSS and icon can be cached.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|svg)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# www -> bare domain, so there's one address.
RewriteCond %{HTTP_HOST} ^www\.suaams\.com\.ng$ [NC]
RewriteRule ^ https://suaams.com.ng%{REQUEST_URI} [R=301,L]

# HTTP -> HTTPS. Leave this off until cPanel's AutoSSL has issued a
# certificate for suaams.com.ng and https://suaams.com.ng opens without
# a warning; switched on before that, every visitor gets the warning.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://suaams.com.ng%{REQUEST_URI} [R=301,L]
