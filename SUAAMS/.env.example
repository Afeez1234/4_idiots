# Copy to `.env` and fill in real values. `.env` is gitignored; this file
# is not, and must never contain a real value.
#
#     cp .env.example .env
#
# app.py now REQUIRES every one of these. It has no hardcoded fallbacks --
# that was the original problem: the real production database password and
# the session/JWT signing keys were committed to the repo as
# `os.environ.get(NAME, <literal>)` defaults, and the "missing environment
# variable" check beneath them could never fire because the resolved value
# was never empty. Absence now stops the app at startup instead.

# ---- Database (Clever Cloud MySQL) ----
DB_HOST=your-mysql-host.mysql.services.clever-cloud.com
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=3306

# ---- Authentication keys ----
# Generate each with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SECRET_KEY signs the web portal's session cookie -- anyone holding it can
# mint an admin session. JWT_SECRET_KEY signs every mobile API token. Both
# must be unique, and neither may ever be committed.
SECRET_KEY=
JWT_SECRET_KEY=

# ---- Check-in beacon (see beacon.py) ----
# HMAC key for the 32-char attendance beacon. Unset means check-in is
# disabled, not weak -- beacon.py fails closed with a logged reason.
BEACON_SIGNING_SECRET=

# ---- Bluetooth check-in (see ble_beacon.py) ----
# HMAC key for the rotating code the terminal broadcasts over BLE -- the
# fallback for phones that can't tap in by NFC. Must match BLE_BEACON_SECRET
# in the terminal's secrets.h. Unset means Bluetooth check-in is OFF for
# everyone (the app hides the option), not weak.
BLE_BEACON_SECRET=

# ---- Terminal authentication (see api/student.py) ----
# Shared secret proving a request came from a provisioned ESP32. Must match
# TERMINAL_ID / TERMINAL_SECRET in the terminal's secrets.h.
TERMINAL_ID=terminal-01
TERMINAL_SECRET=
