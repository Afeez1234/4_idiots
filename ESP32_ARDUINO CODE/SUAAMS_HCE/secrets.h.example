/*
  SUAAMS HCE terminal -- local credentials.

  Copy this file to `secrets.h` in the SAME directory, fill in your real
  values, and flash. `secrets.h` is gitignored; this example file is not,
  so keep real credentials out of it.

  Why this file exists: WiFi SSID/password and the terminal secret used to
  be hardcoded as literals in SUAAMS_HCE.ino, which put a real home network
  (and the owner's name) into version control. The `ssid`/`password`
  constants in the sketch were the ones in git -- rotate those networks.

  NOTE: `secrets.h` is listed in .gitignore. If you have already committed
  one, the credential is in history regardless of what the working tree
  looks like now.
*/

#ifndef SUAAMS_SECRETS_H
#define SUAAMS_SECRETS_H

// ---- WiFi ----
// Up to 5 networks, as {"name", "password"} pairs. Order doesn't matter:
// the terminal joins whichever listed network has the strongest signal,
// tries the next strongest if that fails, and moves off a network whose
// requests get no answer (e.g. a hotspot out of data). Names are
// case-sensitive and must match exactly. Use "" for an open network.
//
// Every password here is stored in the board's flash, readable by anyone
// who takes the terminal and dumps it. Don't list a network you can't
// afford to have leak.
//
// An older secrets.h with a single WIFI_SSID / WIFI_PASSWORD still works.
#define WIFI_NETWORKS \
  {"YOUR_MAIN_WIFI",    "YOUR_MAIN_PASSWORD"}, \
  {"YOUR_BACKUP_WIFI",  "YOUR_BACKUP_PASSWORD"}, \
  {"YOUR_PHONE_HOTSPOT", "YOUR_HOTSPOT_PASSWORD"}

// ---- Backend ----
#define CHECKIN_URL "https://YOUR-DEPLOYMENT/api/v1/student/checkin"

// Health endpoint, used by the terminal's keep-warm ping. See the
// KEEP_WARM section in SUAAMS_HCE.ino for why this matters: a cold
// Render free-tier dyno takes 5-9 seconds to answer, and the beacon
// acceptance window is only 10 seconds.
#define HEALTHZ_URL "https://YOUR-DEPLOYMENT/healthz"

// Offline backlog endpoint. Taps this terminal captured while it could not
// reach the backend are queued in flash and pushed here on reconnect.
// The server records them for a lecturer to review -- it does NOT credit
// them as attendance, because a 10-second beacon is always expired by the
// time it syncs. See api/student.py sync_offline_checkin_backlog().
#define BACKLOG_URL "https://YOUR-DEPLOYMENT/api/v1/student/checkin/backlog"

// ---- Terminal identity ----
// Must match TERMINAL_ID / TERMINAL_SECRET configured on the server
// (see api/student.py's _check_terminal_auth).
#define TERMINAL_ID     "terminal-01"
#define TERMINAL_SECRET "GENERATE_A_LONG_RANDOM_STRING"

// ---- Bluetooth check-in ----
// The rotating code this terminal broadcasts for phones that can't tap in
// by NFC. BLE_BEACON_SECRET must be the SAME value as BLE_BEACON_SECRET on
// the server. Leave it as "" to keep Bluetooth off (NFC still works).
// BLE_TERMINAL_NUMBER identifies this terminal inside the code (1-65535).
#define BLE_BEACON_SECRET   ""
#define BLE_TERMINAL_NUMBER 1

#endif  // SUAAMS_SECRETS_H
