/*
  SUAAMS HCE terminal -- local credentials.

  Copy this file to `secrets.h` in the SAME directory, fill in your real
  values, and flash. `secrets.h` is gitignored; this example file is not,
  so keep real credentials out of it.

  Why this file exists: WiFi SSID/password and the terminal secret used to
  be hardcoded as literals in SUAAMS_HCE.ino, which put a real home network
  (and the owner's name) into version control. The `ssid`/`password`
  constants in the sketch were the ones in git -- rotate those networks.

  NOTE: `secrets.h` is listed in .gitignore. If you have already committed
  one, the credential is in history regardless of what the working tree
  looks like now.
*/

#ifndef SUAAMS_SECRETS_H
#define SUAAMS_SECRETS_H

// ---- WiFi ----
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---- Backend ----
#define CHECKIN_URL "https://YOUR-DEPLOYMENT/api/v1/student/checkin"

// Health endpoint, used by the terminal's keep-warm ping. See the
// KEEP_WARM section in SUAAMS_HCE.ino for why this matters: a cold
// Render free-tier dyno takes 5-9 seconds to answer, and the beacon
// acceptance window is only 3 seconds.
#define HEALTHZ_URL "https://YOUR-DEPLOYMENT/healthz"

// ---- Terminal identity ----
// Must match TERMINAL_ID / TERMINAL_SECRET configured on the server
// (see api/student.py's _check_terminal_auth).
#define TERMINAL_ID     "terminal-01"
#define TERMINAL_SECRET "GENERATE_A_LONG_RANDOM_STRING"

#endif  // SUAAMS_SECRETS_H
